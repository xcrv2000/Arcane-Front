  "field_definitions": {
    "cost": {
      "label": "费用",
      "unit": "点法力",
      "applies_to": "全部卡牌",
      "notes": "部署单位或施放法术时一次性消耗。当前费用上限为 10 点。"
    },
    "count": {
      "label": "生成数量",
      "unit": "个单位",
      "applies_to": "生物",
      "notes": "每次使用该生物卡时生成的单位数量。"
    },
    "hp": {
      "label": "生命",
      "unit": "点",
      "applies_to": "生物",
      "notes": "单个单位的最大生命值，不是整张卡的总生命值。整卡总生命 = hp * count。"
    },
    "damage": {
      "label": "攻击力/法术伤害",
      "unit": "点",
      "applies_to": "全部卡牌",
      "notes": "生物为每次普攻伤害；法术为对单位伤害。"
    },
    "base_damage": {
      "label": "基地伤害",
      "unit": "点",
      "applies_to": "法术",
      "notes": "法术命中基地时造成的伤害。生物攻击基地仍使用 damage。"
    },
    "attack_cooldown": {
      "label": "攻击间隔",
      "unit": "秒/次",
      "applies_to": "生物",
      "notes": "越小攻击越快。单体 DPS = damage / attack_cooldown。"
    },
    "range": {
      "label": "射程",
      "unit": "逻辑单位",
      "applies_to": "生物",
      "notes": "地图长边为 100 个逻辑单位；速度和距离都使用该尺度。"
    },
    "speed": {
      "label": "移动速度",
      "unit": "逻辑单位/秒",
      "applies_to": "生物",
      "notes": "速度 1 表示每秒移动 1 个逻辑单位。"
    },
    "radius": {
      "label": "半径",
      "unit": "逻辑单位",
      "applies_to": "生物和法术",
      "notes": "生物这里填写基础半径，实战碰撞/表现半径 = radius * unit_radius_scale；法术范围不乘倍率。"
    },
    "aoe_radius": {
      "label": "范围伤害半径",
      "unit": "逻辑单位",
      "applies_to": "生物攻击或进化效果",
      "notes": "攻击落点或光环效果的范围伤害半径。"
    },
    "aura_interval": {
      "label": "光环间隔",
      "unit": "秒/次",
      "applies_to": "进化生物",
      "notes": "光环触发频率。光环 DPS = aura_damage / aura_interval。"
    },
    "aura_radius": {
      "label": "光环半径",
      "unit": "逻辑单位",
      "applies_to": "进化生物",
      "notes": "以单位当前位置为中心的周期范围效果半径。"
    },
    "aura_damage": {
      "label": "光环伤害",
      "unit": "点",
      "applies_to": "进化生物",
      "notes": "每次光环触发时造成的伤害。"
    },
    "multi_target_count": {
      "label": "同时攻击目标数",
      "unit": "个目标",
      "applies_to": "进化生物",
      "notes": "用于估算理想多目标 DPS；实际收益取决于可命中的敌人数量。"
    },
    "spell_mode": {
      "label": "法术模式",
